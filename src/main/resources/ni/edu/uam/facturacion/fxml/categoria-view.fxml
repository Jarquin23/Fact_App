<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.facturacion.controller.CategoriaController">

    <!-- Título -->
    <top>
        <Label text="Gestión de categorías"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 10;">
            <BorderPane.alignment>CENTER</BorderPane.alignment>
        </Label>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- Formulario -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="100" prefWidth="120"/>
                </columnConstraints>

                <!-- Fila 0 -->
                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Activa:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <CheckBox fx:id="chkActiva" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            </GridPane>

            <!-- Botones -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnGuardar"  text="Guardar"  onAction="#guardar"/>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizar"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar"/>
                <Button fx:id="btnLimpiar"  text="Limpiar"  onAction="#limpiar"/>
                <Button fx:id="btnCerrar"   text="Cerrar"   onAction="#cerrar"/>
            </HBox>

            <!-- Tabla -->
            <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"     text="ID"      prefWidth="60"/>
                    <TableColumn fx:id="colNombre" text="Nombre"  prefWidth="250"/>
                    <TableColumn fx:id="colActiva" text="Activa"  prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>